# ===== 服务端配置 =====
PORT=3000
NODE_ENV=development

# ===== 数据库配置 (PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatroom
DB_USER=postgres
DB_PASSWORD=postgres

# ===== JWT 配置 =====
JWT_SECRET=change-this-to-a-random-secret-key
JWT_EXPIRES_IN=7d

# ===== 客户端地址 (CORS) =====
CLIENT_URL=http://localhost:5173

# ===== 文件上传 =====
UPLOAD_DIR=uploads
MAX_FILE_SIZE=52428800

# ===== SMTP 邮箱配置 (可选, 也可在管理员后台配置) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# ===== 虚拟终端 (Docker) 配置 (可选, 未安装 Docker 时功能自动禁用) =====
DOCKER_SOCKET_PATH=/var/run/docker.sock
TERMINAL_IMAGE=alpine:latest
TERMINAL_CPU_QUOTA=50000
TERMINAL_MEMORY=536870912
TERMINAL_TIMEOUT_MINUTES=30
TERMINAL_NETWORK_DISABLED=false
