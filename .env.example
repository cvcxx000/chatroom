# ===== 服务端配置 =====
PORT=3000
NODE_ENV=development

# ===== 数据库配置 (PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatroom
DB_USER=postgres
DB_PASSWORD=postgres

# ===== JWT 配置 =====
JWT_SECRET=change-this-to-a-random-secret-key
JWT_EXPIRES_IN=7d

# ===== 客户端地址 (CORS) =====
CLIENT_URL=http://localhost:5173

# ===== 文件上传 =====
UPLOAD_DIR=uploads
MAX_FILE_SIZE=52428800

# ===== SMTP 邮箱配置 (可选, 也可在管理员后台配置) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
