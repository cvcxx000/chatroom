# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (filled by setup wizard)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatroom
DB_USER=postgres
DB_PASSWORD=changeme

# JWT
JWT_SECRET=change-me-to-a-random-secret-key
JWT_EXPIRES_IN=7d

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# SMTP (optional; can be set at runtime via admin panel)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
